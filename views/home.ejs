<%- layout("layouts/boilerplate") %>

<style>
  /* ── Home page local styles (tokens from style.css) ─────── */
  .hero-search-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-3);
    margin-top: var(--sp-6);
  }
  .hero-search-row {
    display: flex;
    gap: var(--sp-2);
    width: 100%;
    max-width: 580px;
  }
  .hero-search-row input {
    flex: 1;
    padding: var(--sp-3) var(--sp-4);
    border-radius: var(--radius-pill);
    border: none;
    font-size: var(--text-base);
    font-family: var(--font-base);
    background: rgba(255,255,255,0.95);
    color: var(--clr-text);
    outline: none;
    box-shadow: var(--shadow-md);
  }
  .hero-search-row input::placeholder { color: var(--clr-text-muted); }
  .hero-btn-primary {
    background: var(--clr-brand);
    color: var(--clr-text-inverse);
    border: none;
    border-radius: var(--radius-pill);
    padding: var(--sp-3) var(--sp-5);
    font-size: var(--text-base);
    font-weight: var(--fw-semi);
    font-family: var(--font-base);
    cursor: pointer;
    white-space: nowrap;
    transition: background var(--transition), transform var(--transition);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
  }
  .hero-btn-primary:hover { background: var(--clr-brand-dark); transform: translateY(-1px); color: #fff; }
  .hero-btn-ai {
    background: rgba(255,255,255,0.15);
    color: var(--clr-text-inverse);
    border: 1.5px solid rgba(255,255,255,0.5);
    border-radius: var(--radius-pill);
    padding: var(--sp-2) var(--sp-4);
    font-size: var(--text-sm);
    font-weight: var(--fw-semi);
    font-family: var(--font-base);
    cursor: pointer;
    white-space: nowrap;
    backdrop-filter: blur(6px);
    transition: background var(--transition), border-color var(--transition);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
  }
  .hero-btn-ai:hover { background: rgba(255,255,255,0.28); border-color: rgba(255,255,255,0.8); color: #fff; }

  /* Category section */
  .section-label {
    font-size: var(--text-xs);
    font-weight: var(--fw-bold);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--clr-text-muted);
    margin-bottom: var(--sp-3);
  }
  .category-scroller {
    display: flex;
    gap: var(--sp-3);
    overflow-x: auto;
    padding-bottom: var(--sp-2);
    scrollbar-width: none;
  }
  .category-scroller::-webkit-scrollbar { display: none; }
  .cat-chip {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-1);
    min-width: 72px;
    padding: var(--sp-3) var(--sp-3);
    border-radius: var(--radius-lg);
    border: 1.5px solid var(--clr-border);
    background: var(--clr-bg);
    text-decoration: none;
    color: var(--clr-text-muted);
    font-size: var(--text-xs);
    font-weight: var(--fw-semi);
    font-family: var(--font-base);
    transition: border-color var(--transition), color var(--transition), background var(--transition), transform var(--transition);
    cursor: pointer;
    white-space: nowrap;
  }
  .cat-chip:hover, .cat-chip.active {
    border-color: var(--clr-brand);
    color: var(--clr-brand);
    background: #fff5f5;
    transform: translateY(-2px);
  }
  .cat-chip i { font-size: 1.3rem; }

  /* Featured section heading */
  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--sp-4);
  }
  .section-title {
    font-size: var(--text-xl);
    font-weight: var(--fw-bold);
    color: var(--clr-text);
  }
  .section-link {
    font-size: var(--text-sm);
    color: var(--clr-brand);
    text-decoration: none;
    font-weight: var(--fw-semi);
  }
  .section-link:hover { text-decoration: underline; }

  /* Featured cards */
  .feat-card {
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--clr-border);
    text-decoration: none;
    color: inherit;
    display: block;
    transition: transform var(--transition), box-shadow var(--transition);
    height: 100%;
  }
  .feat-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
  .feat-card img { width: 100%; height: 210px; object-fit: cover; display: block; }
  .feat-card-body { padding: var(--sp-3) var(--sp-4) var(--sp-4); }
  .feat-card-title { font-weight: var(--fw-bold); font-size: var(--text-base); margin-bottom: 2px; }
  .feat-card-loc   { font-size: var(--text-xs); color: var(--clr-text-muted); }
  .feat-card-price { font-weight: var(--fw-bold); color: var(--clr-text); margin-top: var(--sp-2); }
  .feat-card-foot  { display: flex; justify-content: space-between; align-items: center; margin-top: var(--sp-2); }
  .feat-cat-badge {
    font-size: var(--text-xs);
    font-weight: var(--fw-semi);
    color: var(--clr-text-muted);
    background: var(--clr-bg-subtle);
    border: 1px solid var(--clr-border);
    border-radius: var(--radius-pill);
    padding: 2px var(--sp-3);
  }

  /* AI banner strip */
  .ai-banner {
    background: linear-gradient(135deg, #1e1b4b, #312e81, #4c1d95);
    border-radius: var(--radius-xl);
    padding: var(--sp-6) var(--sp-6);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    margin: var(--sp-8) 0;
    flex-wrap: wrap;
  }
  .ai-banner-text h2 {
    font-size: var(--text-xl);
    font-weight: var(--fw-bold);
    color: #fff;
    margin-bottom: var(--sp-1);
  }
  .ai-banner-text p { color: #c4b5fd; font-size: var(--text-sm); margin: 0; }
  .ai-banner-btn {
    background: linear-gradient(135deg, #7c3aed, #4f46e5);
    color: #fff;
    border: none;
    border-radius: var(--radius-pill);
    padding: var(--sp-3) var(--sp-5);
    font-weight: var(--fw-semi);
    font-size: var(--text-sm);
    font-family: var(--font-base);
    text-decoration: none;
    white-space: nowrap;
    transition: opacity var(--transition), transform var(--transition);
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    flex-shrink: 0;
  }
  .ai-banner-btn:hover { opacity: .88; transform: translateY(-1px); color: #fff; }
</style>

<!-- ── Hero ──────────────────────────────────────────────────────────────── -->
<div class="hero text-center text-white d-flex align-items-center justify-content-center">
  <div style="width:100%;max-width:700px;padding:0 var(--sp-4)">
    <small class="hero-eyebrow">Wanderlust</small>
    <h1 class="hero-title mt-2">Book unique stays around the world</h1>
    <p class="hero-subtitle">Homestays, cabins, castles and more — all in one place.</p>

    <div class="hero-search-wrap">
      <div class="hero-search-row">
        <form style="display:contents" method="GET" action="/listings">
          <input type="text" name="q" placeholder="Where do you want to go?">
          <button type="submit" class="hero-btn-primary">
            <i class="fa-solid fa-magnifying-glass"></i>Search
          </button>
        </form>
      </div>
      <a href="/ai" class="hero-btn-ai">
        <i class="fa-solid fa-wand-magic-sparkles"></i>Try AI Smart Search
      </a>
    </div>
  </div>
</div>

<div class="container mt-5">

  <!-- ── Categories ──────────────────────────────────────────────────────── -->
  <p class="section-label">Browse by category</p>
  <div class="category-scroller mb-5">
    <% for (const cat of categoryMeta) { %>
      <a href="/listings?category=<%= cat.name %>" class="cat-chip">
        <i class="<%= cat.icon %>"></i>
        <span><%= cat.name %></span>
      </a>
    <% } %>
  </div>

  <!-- ── AI Banner ────────────────────────────────────────────────────────── -->
  <div class="ai-banner">
    <div class="ai-banner-text">
      <h2>✨ Meet Wanderlust AI</h2>
      <p>Describe your perfect stay in plain language — romantic hills, family budget, cozy cabin — and our AI finds it instantly.</p>
    </div>
    <a href="/ai" class="ai-banner-btn">
      <i class="fa-solid fa-wand-magic-sparkles"></i>Try AI Search
    </a>
  </div>

  <!-- ── Featured Stays ───────────────────────────────────────────────────── -->
  <div class="section-header">
    <h2 class="section-title">Featured stays</h2>
    <a href="/listings" class="section-link">View all <i class="fa-solid fa-arrow-right ms-1"></i></a>
  </div>

  <div class="row row-cols-xl-4 row-cols-lg-3 row-cols-md-2 row-cols-1 g-4 mb-5">
    <% if (featured && featured.length > 0) { %>
      <% for (const listing of featured) { %>
        <div class="col">
          <a href="/listings/<%= listing._id %>" class="feat-card">
            <img
              src="<%= listing.image ? listing.image.url : '/img/placeholder.svg' %>"
              alt="<%= listing.title %>"
            >
            <div class="feat-card-body">
              <div class="d-flex justify-content-between align-items-start gap-2">
                <div>
                  <div class="feat-card-title"><%= listing.title %></div>
                  <div class="feat-card-loc">
                    <i class="fa-solid fa-location-dot me-1"></i><%= listing.location %>
                  </div>
                </div>
                <% if (listing.rating > 0) { %>
                  <span class="badge bg-dark rounded-pill" style="font-size:var(--text-xs);white-space:nowrap;flex-shrink:0">
                    <i class="fa-solid fa-star text-warning me-1"></i><%= listing.rating %>
                  </span>
                <% } %>
              </div>
              <div class="feat-card-foot">
                <div class="feat-card-price">&#8377;&nbsp;<%= listing.price.toLocaleString("en-IN") %><span style="font-weight:var(--fw-normal);font-size:var(--text-sm);color:var(--clr-text-muted)"> / night</span></div>
                <% if (listing.category) { %>
                  <span class="feat-cat-badge"><%= listing.category %></span>
                <% } %>
              </div>
            </div>
          </a>
        </div>
      <% } %>
    <% } else { %>
      <div class="col-12">
        <div class="alert alert-info" style="border-radius:var(--radius-md)">
          No listings yet. <a href="/listings/new" class="alert-link">Become a host</a> and add the first one!
        </div>
      </div>
    <% } %>
  </div>

</div>