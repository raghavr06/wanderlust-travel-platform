<% layout("layouts/boilerplate") %>

<style>
    #filters{
        display: flex;
        flex-wrap: wrap;
    }
    .filter{
        text-align: center;
        margin-right: 1.5rem;
        margin-top: 0.5rem;
        opacity: 0.55;
        cursor: pointer;
    }
    .filter.active{ opacity: 1; }
    .filter:hover{ opacity: 1; }
    .filter p{ font-size: 0.8rem; margin-top: 0.25rem; margin-bottom: 0; }
    .cat-emoji{ font-size: 1.25rem; }
</style>

<div class="mt-3">
    <div id="filters">
        <a href="/listings" class="filter<%= filters.category ? '' : ' active' %> text-decoration-none text-reset">
            <div class="cat-emoji"><i class="fa-solid fa-house"></i></div>
            <p>All</p>
        </a>
        <% for (const cat of categoryMeta){ %>
            <a href="/listings?category=<%= cat.name %><%= filters.q ? '&q='+filters.q : '' %>" class="filter<%= filters.category === cat.name ? ' active' : '' %> text-decoration-none text-reset">
                <div class="cat-emoji"><i class="<%= cat.icon %>"></i></div>
                <p><%= cat.name %></p>
            </a>
        <% } %>
    </div>

    <div class="d-flex justify-content-between align-items-center my-3">
        <div>
            <h5><b>
                <%= filters.category || "All stays" %>
                <% if(filters.q){ %> for "<%= filters.q %>"<% } %>
            </b></h5>
            <span class="text-muted"><%= allListings.length %> <%= allListings.length === 1 ? "stay" : "stays" %> found</span>
        </div>
        <form method="GET" action="/listings" class="d-flex gap-2">
            <% if(filters.q){ %><input type="hidden" name="q" value="<%= filters.q %>"><% } %>
            <% if(filters.category){ %><input type="hidden" name="category" value="<%= filters.category %>"><% } %>
            <select name="sort" class="form-select form-select-sm w-auto" onchange="this.form.submit()">
                <option value="">Sort by</option>
                <option value="price_asc" <%= filters.sort === 'price_asc' ? 'selected' : '' %>>Price: Low to High</option>
                <option value="price_desc" <%= filters.sort === 'price_desc' ? 'selected' : '' %>>Price: High to Low</option>
                <option value="rating" <%= filters.sort === 'rating' ? 'selected' : '' %>>Top rated</option>
            </select>
        </form>
    </div>

    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
        <% if(allListings.length === 0){ %>
            <div class="alert alert-info col-12">
                No stays match your search.
                <% if(filters.q || filters.category){ %>
                    <a href="/listings" class="alert-link">Clear filters</a>.
                <% } %>
            </div>
        <% } %>
        <% for (const listing of allListings){ %>
            <%- include("../includes/listingCard.ejs", { listing }) %>
        <% } %>
    </div>
</div>