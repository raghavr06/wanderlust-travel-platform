<%- layout("layouts/boilerplate") %>

<style>
  /* ── Listings index local styles ─────────────────────────── */

  /* Filter bar */
  .filter-bar {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    padding: var(--sp-4) 0 var(--sp-3);
    border-bottom: 1px solid var(--clr-border);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .filter-bar::-webkit-scrollbar { display: none; }

  .filter-chip {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    min-width: 64px;
    text-decoration: none;
    color: var(--clr-text-muted);
    font-size: var(--text-xs);
    font-weight: var(--fw-semi);
    font-family: var(--font-base);
    padding: var(--sp-2) var(--sp-3);
    border-radius: var(--radius-lg);
    border: 1.5px solid transparent;
    transition: color var(--transition), border-color var(--transition), background var(--transition);
    white-space: nowrap;
    flex-shrink: 0;
  }
  .filter-chip:hover,
  .filter-chip.active {
    color: var(--clr-brand);
    border-color: var(--clr-brand);
    background: #fff5f5;
  }
  .filter-chip i { font-size: 1.2rem; }

  /* Toolbar */
  .listings-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--sp-3);
    padding: var(--sp-4) 0 var(--sp-3);
  }
  .listings-count {
    font-size: var(--text-sm);
    color: var(--clr-text-muted);
  }
  .listings-title {
    font-size: var(--text-xl);
    font-weight: var(--fw-bold);
    margin: 0;
  }

  /* Sort select */
  .sort-select {
    border-radius: var(--radius-pill) !important;
    border: 1.5px solid var(--clr-border) !important;
    font-size: var(--text-sm) !important;
    padding: var(--sp-2) var(--sp-4) !important;
    background: var(--clr-bg) !important;
    color: var(--clr-text) !important;
    cursor: pointer;
    appearance: auto;
    font-family: var(--font-base);
  }

  /* Listing cards */
  .listing-link {
    text-decoration: none;
    color: inherit;
    display: block;
    height: 100%;
  }
  .listing-card {
    border-radius: var(--radius-lg) !important;
    overflow: hidden;
    border: 1px solid var(--clr-border) !important;
    height: 100%;
    margin-bottom: 0 !important;
    transition: transform var(--transition), box-shadow var(--transition);
    background: var(--clr-bg);
  }
  .listing-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }
  .listing-card .card-img-top {
    border-radius: 0 !important;
    height: 210px;
    width: 100% !important;
    object-fit: cover !important;
    display: block;
    transition: transform 0.35s ease;
  }
  .listing-link:hover .card-img-top { transform: scale(1.04); }
  .listing-card .card-body {
    padding: var(--sp-3) var(--sp-4) var(--sp-4) !important;
  }
  .card-loc  { font-size: var(--text-xs); color: var(--clr-text-muted); }
  .card-price { font-weight: var(--fw-bold); margin-top: var(--sp-2); }
  .card-foot  { display: flex; justify-content: space-between; align-items: center; margin-top: var(--sp-2); }
  .card-cat-badge {
    font-size: var(--text-xs);
    font-weight: var(--fw-semi);
    color: var(--clr-text-muted);
    background: var(--clr-bg-subtle);
    border: 1px solid var(--clr-border);
    border-radius: var(--radius-pill);
    padding: 2px var(--sp-3);
    white-space: nowrap;
  }

  /* Empty state */
  .empty-state {
    text-align: center;
    padding: var(--sp-8) var(--sp-4);
    color: var(--clr-text-muted);
  }
  .empty-state i { font-size: 2.5rem; opacity: .3; display: block; margin-bottom: var(--sp-3); }

  /* AI Quick-search strip */
  .ai-strip {
    background: linear-gradient(90deg, #ede9fe, #dbeafe);
    border-radius: var(--radius-lg);
    padding: var(--sp-3) var(--sp-5);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
    margin-bottom: var(--sp-4);
    flex-wrap: wrap;
  }
  .ai-strip p { margin: 0; font-size: var(--text-sm); color: #3730a3; font-weight: var(--fw-medium); }
  .ai-strip-btn {
    background: linear-gradient(135deg, #7c3aed, #4f46e5);
    color: #fff;
    border: none;
    border-radius: var(--radius-pill);
    padding: var(--sp-2) var(--sp-4);
    font-size: var(--text-xs);
    font-weight: var(--fw-semi);
    text-decoration: none;
    white-space: nowrap;
    transition: opacity var(--transition);
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    flex-shrink: 0;
  }
  .ai-strip-btn:hover { opacity: .85; color: #fff; }
</style>

<div class="mt-2">

  <!-- ── Category filter bar ─────────────────────────────────────────────── -->
  <div class="filter-bar">
    <a href="/listings" class="filter-chip <%= !filters.category ? 'active' : '' %>">
      <i class="fa-solid fa-house"></i>All
    </a>
    <% for (const cat of categoryMeta) { %>
      <a
        href="/listings?category=<%= cat.name %><%= filters.q ? '&q='+encodeURIComponent(filters.q) : '' %>"
        class="filter-chip <%= filters.category === cat.name ? 'active' : '' %>"
      >
        <i class="<%= cat.icon %>"></i><%= cat.name %>
      </a>
    <% } %>
  </div>

  <!-- ── AI strip ────────────────────────────────────────────────────────── -->
  <% if (!filters.q && !filters.category) { %>
  <div class="ai-strip mt-3">
    <p><i class="fa-solid fa-wand-magic-sparkles me-2" style="color:#7c3aed"></i>Looking for <em>romantic hills</em>, <em>family budget</em>, or <em>cozy cabin with pool</em>? Let AI search find it.</p>
    <a href="/ai" class="ai-strip-btn"><i class="fa-solid fa-wand-magic-sparkles"></i>AI Search</a>
  </div>
  <% } %>

  <!-- ── Toolbar ─────────────────────────────────────────────────────────── -->
  <div class="listings-toolbar">
    <div>
      <h1 class="listings-title">
        <%= filters.category || "All stays" %>
        <% if (filters.q) { %><span style="font-weight:var(--fw-normal);color:var(--clr-text-muted)"> for "<%= filters.q %>"</span><% } %>
      </h1>
      <p class="listings-count mb-0">
        <%= allListings.length %> <%= allListings.length === 1 ? "stay" : "stays" %> found
      </p>
    </div>

    <form method="GET" action="/listings" class="d-flex align-items-center gap-2">
      <% if (filters.q) { %><input type="hidden" name="q" value="<%= filters.q %>"><% } %>
      <% if (filters.category) { %><input type="hidden" name="category" value="<%= filters.category %>"><% } %>
      <select name="sort" class="sort-select form-select" onchange="this.form.submit()">
        <option value="">Sort by</option>
        <option value="price_asc"  <%= filters.sort === 'price_asc'  ? 'selected' : '' %>>Price: Low → High</option>
        <option value="price_desc" <%= filters.sort === 'price_desc' ? 'selected' : '' %>>Price: High → Low</option>
        <option value="rating"     <%= filters.sort === 'rating'     ? 'selected' : '' %>>Top rated</option>
      </select>
    </form>
  </div>

  <!-- ── Listings grid ───────────────────────────────────────────────────── -->
  <div class="row row-cols-xl-3 row-cols-md-2 row-cols-1 g-4 mb-5">
    <% if (allListings.length === 0) { %>
      <div class="col-12">
        <div class="empty-state">
          <i class="fa-solid fa-compass"></i>
          <p style="font-size:var(--text-lg);font-weight:var(--fw-semi);color:var(--clr-text)">No stays found.</p>
          <% if (filters.q || filters.category) { %>
            <p><a href="/listings" style="color:var(--clr-brand)">Clear filters</a> to see all stays, or <a href="/ai" style="color:var(--clr-accent)">try AI search</a>.</p>
          <% } %>
        </div>
      </div>
    <% } %>

    <% for (const listing of allListings) { %>
      <div class="col">
        <a href="/listings/<%= listing._id %>" class="listing-link">
          <div class="listing-card card">
            <div style="overflow:hidden">
              <img
                src="<%= listing.image ? listing.image.url : '/img/placeholder.svg' %>"
                class="card-img-top"
                alt="<%= listing.title %>"
              >
            </div>
            <div class="card-body">
              <div class="d-flex justify-content-between align-items-start gap-2">
                <div>
                  <p class="mb-0" style="font-weight:var(--fw-bold)"><%= listing.title %></p>
                  <p class="card-loc mb-0"><i class="fa-solid fa-location-dot me-1"></i><%= listing.location %></p>
                </div>
                <% if (listing.rating > 0) { %>
                  <span class="badge bg-dark rounded-pill" style="font-size:var(--text-xs);white-space:nowrap;flex-shrink:0">
                    <i class="fa-solid fa-star text-warning me-1"></i><%= listing.rating %>
                    <span style="opacity:.65">(<%= listing.numReviews %>)</span>
                  </span>
                <% } %>
              </div>
              <div class="card-foot">
                <p class="card-price mb-0">
                  &#8377;&nbsp;<%= listing.price.toLocaleString("en-IN") %>
                  <span style="font-weight:var(--fw-normal);font-size:var(--text-sm);color:var(--clr-text-muted)">/night</span>
                </p>
                <% if (listing.category) { %>
                  <span class="card-cat-badge"><%= listing.category %></span>
                <% } %>
              </div>
            </div>
          </div>
        </a>
      </div>
    <% } %>
  </div>

</div>