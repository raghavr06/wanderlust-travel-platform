<%- layout("layouts/boilerplate") %>

<style>
  /* AI page — uses global design tokens from style.css */
  .ai-hero {
    background: linear-gradient(135deg, #0f0c29, #302b63, #24243e);
    padding: var(--sp-8) var(--sp-5) var(--sp-6);
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .ai-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 60% 30%, rgba(124,58,237,.25) 0%, transparent 65%),
      radial-gradient(ellipse at 20% 80%, rgba(30,144,255,.15) 0%, transparent 60%);
    pointer-events: none;
  }
  .ai-hero-eyebrow {
    font-size: var(--text-xs);
    letter-spacing: .2em;
    color: #a78bfa;
    text-transform: uppercase;
    font-weight: var(--fw-bold);
  }
  .ai-hero h1 {
    font-size: clamp(1.5rem, 4vw, var(--text-3xl));
    font-weight: var(--fw-xbold);
    color: var(--clr-text-inverse);
    margin: var(--sp-2) 0;
  }
  .ai-hero > p { color: #c4b5fd; font-size: var(--text-base); }

  /* Search input */
  .ai-search-wrap { position: relative; max-width: 640px; margin: var(--sp-5) auto 0; }
  .ai-search-wrap input {
    width: 100%;
    padding: .85rem 3.5rem .85rem var(--sp-5);
    border-radius: var(--radius-pill);
    border: 2px solid rgba(167,139,250,.45);
    background: rgba(255,255,255,.07);
    color: var(--clr-text-inverse);
    font-size: var(--text-base);
    font-family: var(--font-base);
    backdrop-filter: blur(8px);
    transition: border-color var(--transition);
    outline: none;
  }
  .ai-search-wrap input::placeholder { color: rgba(255,255,255,.4); }
  .ai-search-wrap input:focus { border-color: #a78bfa; }
  .ai-search-wrap button {
    position: absolute; right: 6px; top: 50%;
    transform: translateY(-50%);
    background: linear-gradient(135deg, var(--clr-accent), #4f46e5);
    border: none; border-radius: var(--radius-pill);
    color: var(--clr-text-inverse);
    padding: var(--sp-2) var(--sp-4);
    font-size: var(--text-sm);
    font-weight: var(--fw-semi);
    font-family: var(--font-base);
    cursor: pointer;
    transition: opacity var(--transition);
  }
  .ai-search-wrap button:hover { opacity: .85; }

  /* Suggestion pills */
  .ai-pills { display: flex; flex-wrap: wrap; gap: var(--sp-2); justify-content: center; margin-top: var(--sp-4); }
  .ai-pill {
    background: rgba(167,139,250,.12);
    border: 1px solid rgba(167,139,250,.3);
    color: #c4b5fd;
    padding: var(--sp-1) var(--sp-3);
    border-radius: var(--radius-pill);
    font-size: var(--text-xs);
    font-weight: var(--fw-medium);
    cursor: pointer;
    transition: background var(--transition), color var(--transition);
    text-decoration: none;
  }
  .ai-pill:hover { background: rgba(167,139,250,.28); color: var(--clr-text-inverse); }

  /* Mode toggle */
  .ai-mode-bar { display: flex; justify-content: center; gap: var(--sp-3); margin: var(--sp-5) 0 var(--sp-4); }
  .ai-mode-btn {
    padding: var(--sp-2) var(--sp-5);
    border-radius: var(--radius-pill);
    border: 2px solid var(--clr-border);
    background: var(--clr-bg);
    font-weight: var(--fw-semi);
    font-size: var(--text-sm);
    font-family: var(--font-base);
    cursor: pointer;
    color: var(--clr-text);
    text-decoration: none;
    transition: all var(--transition);
  }
  .ai-mode-btn.active,
  .ai-mode-btn:hover {
    background: linear-gradient(135deg, var(--clr-accent), #4f46e5);
    border-color: transparent;
    color: var(--clr-text-inverse);
  }

  /* Rationale banner */
  .ai-rationale {
    background: var(--clr-accent-light);
    border-left: 4px solid var(--clr-accent);
    border-radius: var(--radius-md);
    padding: var(--sp-3) var(--sp-4);
    color: #3730a3;
    font-size: var(--text-sm);
    font-weight: var(--fw-medium);
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    margin-bottom: var(--sp-5);
  }

  /* Result / Recommendation cards */
  .ai-card {
    border: 1px solid var(--clr-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: transform var(--transition), box-shadow var(--transition);
    text-decoration: none;
    color: inherit;
    display: block;
  }
  .ai-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
  .ai-card img { width: 100%; height: 200px; object-fit: cover; }
  .ai-card-body { padding: var(--sp-4); }
  .ai-card-title { font-weight: var(--fw-bold); font-size: var(--text-base); margin-bottom: 2px; }
  .ai-card-loc   { font-size: var(--text-xs); color: var(--clr-text-muted); }
  .ai-card-price { font-weight: var(--fw-bold); font-size: var(--text-base); color: var(--clr-text); margin-top: var(--sp-2); }

  .ai-badge {
    display: inline-block;
    background: var(--clr-bg-subtle);
    border: 1px solid var(--clr-border);
    border-radius: var(--radius-pill);
    padding: 2px var(--sp-3);
    font-size: var(--text-xs);
    color: var(--clr-text-muted);
    margin-top: var(--sp-2);
    margin-right: var(--sp-1);
    font-weight: var(--fw-medium);
  }
  .ai-badge.ai-badge-ai {
    background: linear-gradient(135deg, var(--clr-accent), #4f46e5);
    color: var(--clr-text-inverse);
    border-color: transparent;
  }

  /* Match reason */
  .ai-match-reason {
    font-size: var(--text-xs);
    color: var(--clr-accent);
    font-weight: var(--fw-semi);
    margin-top: var(--sp-2);
    display: flex;
    align-items: flex-start;
    gap: var(--sp-2);
    line-height: 1.4;
  }

  /* AI score ring */
  .ai-score {
    width: 36px; height: 36px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--clr-accent), #4f46e5);
    color: var(--clr-text-inverse);
    font-size: var(--text-xs);
    font-weight: var(--fw-bold);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  /* Source tag */
  .ai-source-tag {
    font-size: var(--text-xs);
    background: var(--clr-bg-subtle);
    border: 1px solid var(--clr-border);
    border-radius: var(--radius-sm);
    padding: 2px var(--sp-2);
    color: var(--clr-text-muted);
    white-space: nowrap;
  }

  /* Empty state */
  .ai-empty {
    text-align: center;
    padding: var(--sp-8) var(--sp-4);
    color: var(--clr-text-muted);
  }
  .ai-empty i { font-size: 2.5rem; opacity: .3; display: block; margin-bottom: var(--sp-3); }
</style>

<!-- ── Hero ──────────────────────────────────────────────────────────────── -->
<div class="ai-hero">
  <p class="ai-hero-eyebrow">✨ Wanderlust AI</p>
  <h1>Find your perfect stay — just describe it</h1>
  <p>Ask naturally: <em>"romantic place near hills with pool"</em>, <em>"family budget under $100"</em>&hellip;</p>

  <form class="ai-search-wrap" method="GET" action="/ai/search" id="ai-search-form">
    <input
      type="text"
      name="q"
      id="ai-search-input"
      placeholder='Try "cozy mountain cabin with wifi" or "beach resort family budget"'
      value="<%= query %>"
      autocomplete="off"
    >
    <button type="submit"><i class="fa-solid fa-wand-magic-sparkles me-1"></i>Search</button>
  </form>

  <!-- Suggestion pills -->
  <div class="ai-pills">
    <% const suggestions = [
      "Romantic stay near hills",
      "Family budget under $100",
      "Mountain retreat with pool",
      "Camping by the lake",
      "Luxury castle getaway",
      "Best hospitality picks"
    ]; %>
    <% for (const s of suggestions) { %>
      <a href="/ai/search?q=<%= encodeURIComponent(s) %>" class="ai-pill"><%= s %></a>
    <% } %>
  </div>
</div>

<!-- ── Page body ─────────────────────────────────────────────────────────── -->
<div class="container mt-4 mb-5">

  <!-- Mode toggle -->
  <div class="ai-mode-bar">
    <a href="/ai/search" class="ai-mode-btn <%= mode === 'search' ? 'active' : '' %>">
      <i class="fa-solid fa-magnifying-glass me-1"></i>AI Search
    </a>
    <a href="/ai/recommendations" class="ai-mode-btn <%= mode === 'recommendations' ? 'active' : '' %>">
      <i class="fa-solid fa-star me-1"></i>For You<% if (!currUser) { %> <span style="font-size:.7rem;opacity:.6">(login)</span><% } %>
    </a>
  </div>

  <!-- ── AI Search results ───────────────────────────────────────────────── -->
  <% if (mode === 'search' && results !== null) { %>

    <% if (rationale) { %>
      <div class="ai-rationale">
        <i class="fa-solid fa-brain" style="flex-shrink:0"></i>
        <span><strong>AI understood:</strong> <%= rationale %></span>
        <span class="ai-source-tag ms-auto"><%= source %></span>
      </div>
    <% } %>

    <div class="d-flex align-items-center mb-4">
      <h5 class="mb-0"><b>Results for "<%= query %>"</b></h5>
      <span class="ms-2" style="font-size:var(--text-sm);color:var(--clr-text-muted)">
        <%= results.length %> <%= results.length === 1 ? "stay" : "stays" %> found
      </span>
    </div>

    <% if (results.length === 0) { %>
      <div class="ai-empty">
        <i class="fa-solid fa-magnifying-glass"></i>
        <p>No matching stays found. Try a different description or <a href="/listings">browse all listings</a>.</p>
      </div>
    <% } else { %>
      <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 g-4">
        <% for (const listing of results) { %>
          <div class="col">
            <a href="/listings/<%= listing._id %>" class="ai-card">
              <img src="<%= listing.image ? listing.image.url : '/img/placeholder.svg' %>" alt="<%= listing.title %>">
              <div class="ai-card-body">
                <div class="d-flex justify-content-between align-items-start gap-2">
                  <div>
                    <div class="ai-card-title"><%= listing.title %></div>
                    <div class="ai-card-loc"><i class="fa-solid fa-location-dot me-1"></i><%= listing.location %></div>
                  </div>
                  <% if (listing.rating > 0) { %>
                    <span class="badge bg-dark rounded-pill" style="font-size:var(--text-xs);white-space:nowrap;flex-shrink:0">
                      <i class="fa-solid fa-star text-warning me-1"></i><%= listing.rating %>
                      <span style="opacity:.65">(<%= listing.numReviews %>)</span>
                    </span>
                  <% } %>
                </div>
                <div class="ai-card-price">&#8377;&nbsp;<%= listing.price.toLocaleString("en-IN") %> / night</div>
                <% if (listing.category) { %><span class="ai-badge"><%= listing.category %></span><% } %>
                <span class="ai-badge ai-badge-ai"><i class="fa-solid fa-wand-magic-sparkles me-1"></i>AI Pick</span>
              </div>
            </a>
          </div>
        <% } %>
      </div>
    <% } %>

  <% } %>

  <!-- ── Recommendations ────────────────────────────────────────────────── -->
  <% if (mode === 'recommendations' && recommendations !== null) { %>

    <% if (reasoning) { %>
      <div class="ai-rationale">
        <i class="fa-solid fa-brain" style="flex-shrink:0"></i>
        <span><strong>Curated for you:</strong> <%= reasoning %></span>
        <span class="ai-source-tag ms-auto"><%= source %></span>
      </div>
    <% } %>

    <div class="d-flex align-items-center mb-4">
      <h5 class="mb-0"><b><%= currUser ? "Picks based on your travel history" : "Top featured stays" %></b></h5>
      <span class="ms-2" style="font-size:var(--text-sm);color:var(--clr-text-muted)">
        <%= recommendations.length %> curated stays
      </span>
    </div>

    <% if (recommendations.length === 0) { %>
      <div class="ai-empty">
        <i class="fa-solid fa-suitcase"></i>
        <p>No recommendations yet. <a href="/listings">Book a stay</a> and we'll personalise your next trip!</p>
      </div>
    <% } else { %>
      <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 g-4">
        <% for (const listing of recommendations) { %>
          <div class="col">
            <a href="/listings/<%= listing._id %>" class="ai-card">
              <img src="<%= listing.image ? listing.image.url : '/img/placeholder.svg' %>" alt="<%= listing.title %>">
              <div class="ai-card-body">
                <div class="d-flex justify-content-between align-items-start gap-2">
                  <div>
                    <div class="ai-card-title"><%= listing.title %></div>
                    <div class="ai-card-loc"><i class="fa-solid fa-location-dot me-1"></i><%= listing.location %></div>
                  </div>
                  <% if (listing.matchScore !== undefined) { %>
                    <div class="ai-score" title="AI Match Score"><%= listing.matchScore %></div>
                  <% } else if (listing.rating > 0) { %>
                    <span class="badge bg-dark rounded-pill" style="font-size:var(--text-xs);flex-shrink:0">
                      <i class="fa-solid fa-star text-warning me-1"></i><%= listing.rating %>
                    </span>
                  <% } %>
                </div>
                <div class="ai-card-price">&#8377;&nbsp;<%= listing.price.toLocaleString("en-IN") %> / night</div>
                <% if (listing.category) { %><span class="ai-badge"><%= listing.category %></span><% } %>
                <% if (listing.matchReason) { %>
                  <div class="ai-match-reason"><i class="fa-solid fa-circle-check" style="flex-shrink:0;margin-top:2px"></i><%= listing.matchReason %></div>
                <% } %>
              </div>
            </a>
          </div>
        <% } %>
      </div>
    <% } %>

  <% } %>

  <!-- ── Landing state ─────────────────────────────────────────────────── -->
  <% if (mode === 'search' && results === null) { %>
    <div class="ai-empty mt-4">
      <i class="fa-solid fa-wand-magic-sparkles" style="opacity:1;color:var(--clr-accent)"></i>
      <p style="color:var(--clr-text);font-size:var(--text-lg);font-weight:var(--fw-semi)">Describe what you're looking for above.</p>
      <p style="font-size:var(--text-sm)">
        Or <a href="/listings">browse all listings</a>&nbsp;·&nbsp;<a href="/ai/recommendations">See personalised picks</a>
      </p>
    </div>
  <% } %>

</div>
