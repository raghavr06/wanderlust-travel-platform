<style>
  /* Navbar — token-driven, no hard-coded values */
  .nav-bell {
    position: relative;
    color: var(--clr-text);
    font-size: 1.2rem;
    margin-right: var(--sp-3);
    transition: color var(--transition);
  }
  .nav-bell:hover { color: var(--clr-brand); text-decoration: none; }
  .nav-bell .badge {
    position: absolute;
    top: -6px;
    right: -10px;
    font-size: var(--text-xs);
    background: var(--clr-brand);
  }
  .nav-ai-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-1);
    background: var(--clr-accent-light);
    color: var(--clr-accent) !important;
    border-radius: var(--radius-pill);
    padding: 4px var(--sp-3);
    font-size: var(--text-xs);
    font-weight: var(--fw-bold);
    text-decoration: none;
    transition: background var(--transition), color var(--transition);
    border: 1.5px solid rgba(124,58,237,.25);
  }
  .nav-ai-btn:hover {
    background: var(--clr-accent);
    color: var(--clr-text-inverse) !important;
    border-color: var(--clr-accent);
  }
  /* signup/login pill buttons */
  .nav-btn-outline {
    border: 1.5px solid var(--clr-border) !important;
    border-radius: var(--radius-pill) !important;
    padding: 4px var(--sp-4) !important;
    font-size: var(--text-sm) !important;
    font-weight: var(--fw-semi) !important;
    transition: border-color var(--transition), background var(--transition) !important;
  }
  .nav-btn-outline:hover {
    border-color: var(--clr-text) !important;
    background: var(--clr-bg-subtle) !important;
  }
  .nav-btn-fill {
    border-radius: var(--radius-pill) !important;
    padding: 4px var(--sp-4) !important;
    font-size: var(--text-sm) !important;
    font-weight: var(--fw-semi) !important;
    background: var(--clr-text) !important;
    color: var(--clr-text-inverse) !important;
    border: 1.5px solid var(--clr-text) !important;
    transition: background var(--transition) !important;
  }
  .nav-btn-fill:hover { background: #333 !important; }
</style>

<nav class="navbar navbar-expand-md sticky-top">
  <div class="container-fluid px-4">

    <!-- Brand -->
    <a class="navbar-brand d-flex align-items-center gap-2" href="/">
      <i class="fa-solid fa-compass"></i>
      <span>Wanderlust</span>
    </a>

    <button class="navbar-toggler border-0" type="button"
      data-bs-toggle="collapse" data-bs-target="#navbarMain"
      aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarMain">

      <!-- Left links -->
      <div class="navbar-nav me-3">
        <a class="nav-link" href="/listings">Explore</a>
      </div>

      <!-- Centre search -->
      <form class="d-flex flex-grow-1 mx-2" role="search" method="GET" action="/listings" style="max-width:400px">
        <input
          class="form-control search-inp me-2"
          name="q"
          type="search"
          placeholder="Search destinations…"
          style="min-width:0"
        >
        <button class="btn search-btn" type="submit">
          <i class="fa-solid fa-magnifying-glass"></i>
        </button>
      </form>

      <!-- AI pill -->
      <a href="/ai" class="nav-ai-btn me-3">
        <i class="fa-solid fa-wand-magic-sparkles"></i>
        <span>AI</span>
      </a>

      <!-- Right user links -->
      <div class="navbar-nav ms-auto align-items-center gap-2">
        <% if (currUser) { %>
          <!-- Notification bell -->
          <a class="nav-bell" href="/notifications" title="Notifications">
            <i class="fa-regular fa-bell"></i>
            <% if (unreadCount && unreadCount > 0) { %>
              <span class="badge rounded-pill"><%= unreadCount %></span>
            <% } %>
          </a>
          <a class="nav-link" href="/listings/new">Add Listing</a>
          <a class="nav-link fw-semibold" href="/dashboard">Dashboard</a>
          <a class="nav-link" href="/profile">My Bookings</a>
          <a class="nav-link" href="/logout">Logout</a>
        <% } else { %>
          <a class="nav-link nav-btn-outline" href="/signup">Sign Up</a>
          <a class="nav-link nav-btn-fill"    href="/login">Log In</a>
        <% } %>
      </div>

    </div>
  </div>
</nav>