# WanderLust - environment variables
# Copy this file to .env and fill in real values.

MONGO_URL=mongodb://127.0.0.1:27017/wanderlust
REDIS_URL=redis://127.0.0.1:6379
SESSION_SECRET=change-me-to-a-long-random-string

# Cloudinary (listing image uploads)
CLOUD_NAME=your-cloud-name
CLOUD_API_KEY=your-api-key
CLOUD_API_SECRET=your-api-secret

# Nuitee / LiteAPI Live Travel & Hotel Database Integration
NUITEE_API_KEY=sand_e4b7417b-8a09-4333-8004-dc834032a11b
NUITEE_API_URL=https://api.liteapi.travel/v3.0

# Mistral AI — Smart Search & Personalized Recommendations
# Get your key at: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=your-mistral-api-key
MISTRAL_MODEL=mistral-small-latest
# Max tokens per individual LLM response (keep low for fast JSON extraction)
MISTRAL_MAX_TOKENS=300
# Monthly/per-minute token budget guard (50k TPM default)
MISTRAL_TPM_LIMIT=50000